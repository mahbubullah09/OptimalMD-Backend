# Copy to .env and fill in. .env is gitignored — never commit real credentials.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=

# Sign the admin JWT. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Public site: called after content changes so ISR pages refresh
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# Used only by `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
