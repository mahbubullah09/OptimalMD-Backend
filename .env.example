# Copy to .env for local development. .env is gitignored — never commit real
# credentials. On Vercel, set these in Project Settings -> Environment Variables.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string.
# Atlas Network Access must allow the host's IPs. Vercel functions do not have
# a fixed IP, so either allow 0.0.0.0/0 (and rely on credentials) or use an
# Atlas Private Endpoint.
MONGODB_URI=

# Signs the admin JWT. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call this API.
# Local:      http://localhost:3000
# Production: https://optimalmd-demo.vercel.app
# Vercel preview deployments get a new hostname per deploy, so add them here
# as needed — this is an exact-match list on purpose.
CORS_ORIGINS=http://localhost:3000

# The public site, called after a content change so its static pages refresh.
# Local:      http://localhost:3000/api/revalidate
# Production: https://optimalmd-demo.vercel.app/api/revalidate
REVALIDATE_URL=http://localhost:3000/api/revalidate
# Must match REVALIDATE_SECRET in the frontend.
REVALIDATE_SECRET=

# Used only by `npm run seed:admin`; remove once the account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
